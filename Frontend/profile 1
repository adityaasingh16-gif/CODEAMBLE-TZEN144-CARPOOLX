              ),

              const SizedBox(height: 25),

              profileTile(Icons.phone, "Phone Number", "+91 XXXXX XXXXX"),
              profileTile(Icons.email, "Email", "johndoe@gmail.com"),
              profileTile(Icons.people, "Emergency Contacts", "2 Contacts"),

              const SizedBox(height: 15),

              profileButton(
                Icons.warning_amber_rounded,
                "SOS",
                Colors.red,
              ),

              profileButton(
                Icons.settings,
                "Settings",
                Colors.blue,
              ),

              profileButton(
                Icons.lock_outline,
                "Change Password",
                Colors.orange,
              ),

              profileButton(
                Icons.logout,
                "Logout",
                Colors.black87,
              ),

              const SizedBox(height: 20),

              const Text(
                "Version 1.0.0",
                style: TextStyle(color: Colors.grey),
              ),
            ],
          ),
